# Copy this file to .env and fill in real values.
# Get this string from Azure Portal → your SQL database → Connection strings → ADO.NET
# Existing Azure resources: sql-clinicapp-66012555 / free-sql-db-9978530
# Format: Server=tcp:sql-clinicapp-66012555.database.windows.net,1433;Initial Catalog=free-sql-db-9978530;Persist Security Info=False;User ID=<user>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
AZURE_SQL_CONNECTION_STRING=

# Port for the API (Azure App Service sets PORT automatically)
PORT=8080
